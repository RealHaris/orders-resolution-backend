{
  "name": "orders-settlements-backend",
  "version": "1.0.0",
  "description": "Orders and Settlements API",
  "main": "dist/main.js",
  "scripts": {
    "start": "node dist/main.js",
    "dev": "NODE_ENV=development nodemon --exec \"ts-node -r tsconfig-paths/register src/main.ts\"",
    "build": "tsc && tsc-alias -p tsconfig.json",
    "lint": "biome lint ./src",
    "lint:fix": "biome lint --write ./src",
    "format": "biome format --write ./src",
    "check": "biome check ./src",
    "check:fix": "biome check --write ./src",
    "ci": "biome ci ./src && tsc --noEmit"
  },
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=22.22.3 <23"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.18.3",
    "express-validator": "^7.0.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.6.3",
    "pino": "^10.2.1",
    "pino-pretty": "^13.1.3",
    "rate-limiter-flexible": "^9.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.10",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.19.21",
    "nodemon": "^3.1.0",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  }
}
